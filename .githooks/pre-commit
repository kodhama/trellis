#!/bin/sh
set -eu

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

if [ ! -x node_modules/.bin/eslint ]; then
  echo "Trellis pre-commit checks need the pinned development tools. Run: npm ci" >&2
  exit 1
fi
if ! command -v shellcheck >/dev/null 2>&1; then
  echo "Trellis pre-commit checks need ShellCheck on PATH (for example: brew install shellcheck)." >&2
  exit 1
fi

npm run quality
